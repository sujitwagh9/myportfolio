# ── Required ────────────────────────────────────────────────────────────────
# Public URL of the site, no trailing slash. Used for SEO, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://example.com

# Gemini API key from https://aistudio.google.com/apikey (server-side only, never prefix
# with NEXT_PUBLIC_). Powers the AI chat, job-fit analyzer, hero greeting and semantic search.
# Without it the AI panels show a "not configured" message and search uses keywords.
GEMINI_API_KEY=

# Mock AI mode: test the chat and job-fit UI without a key.
# Answers are assembled locally from your content. Never enable on a public deployment.
AI_MOCK=false

# ── Optional: AI models ─────────────────────────────────────────────────────
# Text model (default gemini-3.5-flash-lite). For better answers try gemini-3.8-flash.
GEMINI_MODEL=
# Embedding model for semantic search, built at `npm run build` (default gemini-embedding-001).
GEMINI_EMBEDDING_MODEL=

# ── Optional: rate limiting across serverless instances (recommended on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Random string used to hash client IPs in logs.
LOG_SALT=change-me

# ── Optional: contact form (Resend) ─────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain you verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <hello@example.com>"

# ── Optional: Cloudflare Turnstile spam protection ──────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional: Plausible analytics (privacy-friendly, no cookies) ───────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# For self-hosted Plausible: https://plausible.example.com/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=

# ── Self-hosting with docker compose + Caddy ────────────────────────────────
DOMAIN=example.com
ACME_EMAIL=you@example.com
